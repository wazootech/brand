{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Wazoo Brand",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#FF9800",
    "light": "#FFB74D",
    "dark": "#F57C00"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#fafaf9",
      "dark": "#040404"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "Wazoo Brand"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/wazootech/brand"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Welcome",
        "pages": [
          "introduction",
          "manifesto"
        ]
      },
      {
        "group": "Brand",
        "pages": [
          "brand/colors",
          "brand/typography",
          "brand/motion"
        ]
      },
      {
        "group": "Assets",
        "pages": [
          "assets"
        ]
      }
    ]
  }
}
